# ============================================================
# 고충처리 자료 검색 지원 시스템 — 환경변수 예시
# ------------------------------------------------------------
# 이 파일은 Git에 올라가는 "예시" 파일입니다. 빈 값으로 두세요.
# 실제 키는 이 파일을 복사한 `.env` 에 채워주세요.
#   $ cp .env.example .env
# `.env` 는 `.gitignore` 에 의해 Git에 절대 올라가지 않습니다.
# ============================================================

# ----- Supabase (서버 사이드 전용) -----
# Supabase 대시보드 > Project Settings > API
# SUPABASE_SERVICE_KEY = service_role (secret) JWT — anon 키 넣으면 ingest 가 permission denied 납니다
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ----- Supabase (클라이언트 노출 가능) -----
# NEXT_PUBLIC_ 접두사가 붙은 변수는 브라우저 번들에 포함됩니다.
# 그래서 절대 SERVICE_KEY 같은 비밀 키를 여기에 넣지 마세요.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ----- Gemini (서버 사이드 전용) -----
# Google AI Studio > Get API Key
GEMINI_API_KEY=

# ----- 법제처 Open API (서버 사이드 전용) -----
# open.law.go.kr 에서 발급
KOREAN_LAW_API_KEY=
# 이전 레포나 일부 도구가 LAW_OC 이름을 쓰는 경우를 위한 대체 변수
LAW_OC=
